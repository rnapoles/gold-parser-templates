##LANGUAGE 'Text'
##TEMPLATE-NAME 'Formatted Text - All Tables'
##ENGINE-NAME 'None'
##SYSTEM-VERSION 'N/A'
##AUTHOR 'Devin Cook' 
##FILE-EXTENSION 'txt'
##NOTES
This template outputs all the tables using formatted text. The examples used in the documentation were made using this template.
##END-NOTES
##ID-SEPARATOR '_'

=============================================== 
FILE INFORMATION
===============================================
Output File Path : %Output-File-Path%
Output Path      : %Output-Path%
Output File      : %Output-File%
Output File Base : %Output-File-Base%

=============================================== 
PROPERTIES
===============================================
##PROPERTIES
Name              : %Name%
Version           : %Version%
Author            : %Author%
About             : %About%
Character Set     : %Character-Set%
Character Mapping : %Character-Mapping%
Generated By      : %Generated-By%
Generated Date    : %Generated-Date%
##END-PROPERTIES

=============================================== 
SYMBOL TABLE
===============================================
##SYMBOL-TABLE
Table Count: %Count%
##SYMBOLS
   Symbol %Index%
      Name  : %Name%
      ID    : %ID%
      Value : %Value%
      Type  : %Type%
      Group : %Group%

##END-SYMBOLS
##END-SYMBOL-TABLE

=============================================== 
LEXICAL GROUPS
===============================================
##GROUP-TABLE
Table Count: %Count%
##GROUPS
   Group %Index%
      Name       : %Name%
      Container  : %Container%
      Start      : %Start%
      End        : %End%
      Advanced   : %Advance%
      Ending     : %Ending%
      Nested Groups :
##NESTED-GROUPS
         Group %Nested-Index%
         Name : %Nested-Name%
         
##END-NESTED-GROUPS

##END-GROUPS
##END-GROUP-TABLE

=============================================== 
PRODUCTION TABLE
===============================================
##PRODUCTION-TABLE
Table Count: %Count%
##PRODUCTIONS
   Production %Index%
      Value       : %Value%
      Nonterminal : %Nonterminal-Index%
      Description : %Description%
      Symbol Count: %Symbol-Count%
      Handle:
##PRODUCTION-SYMBOLS   
         %SymbolIndex%
##END-PRODUCTION-SYMBOLS

##END-PRODUCTIONS
##END-PRODUCTION-TABLE

=============================================== 
CHARACTER SET TABLE
===============================================
##CHAR-SET-TABLE
Table Count: %Count%
##DELIMITER ','
##RANGE-CHARS '..'
##CHAR-SETS
   Set %Index% 
      Char Count    : %CharCount% 
      Chars (XML)   : %Chars.XML% 
      Chars (List)  : %Chars.List%
      Chars (Range) : %Chars.Range-List%
      Individual Characters:
##CHARS
         %Unicode-Index%
##END-CHARS

##END-CHAR-SETS
##END-CHAR-SET-TABLE

=============================================== 
DFA TABLE
===============================================
##DFA-TABLE
Table Count: %Count%
Initial State: %Initial-State%
##DFA-STATES
   State %Index%
      Accept: %Accept-Index%
      Edge Count: %Edge-Count%
      Edges:
##DFA-EDGES
         Set %Char-Set-Index% : Goto %Target%
##END-DFA-EDGES

##END-DFA-STATES
##END-DFA-TABLE

=============================================== 
LALR TABLE
===============================================
##LALR-TABLE
Table Count: %Count%
Initial State: %Initial-State%
##LALR-STATES
   State %Index%   
      Action Count: %Action-Count%
      Actions:
##LALR-ACTIONS
         Symbol %Symbol-Index% : %Action-Name% (%Action%) : Target %Value%
##END-LALR-ACTIONS

##END-LALR-STATES
##END-LALR-TABLE
