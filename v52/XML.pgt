##LANGUAGE 'Text'
##TEMPLATE-NAME 'XML - 5.0'
##ENGINE-NAME 'None'
##SYSTEM-VERSION 'n/a'
##AUTHOR 'Devin Cook' 
##FILE-EXTENSION 'xml'
##NOTES
This template outputs the tables using XML format. This template basically performs the same duties as the Export to XML feature.
##END-NOTES
<?GOLDParserTables version="5.0"?>
<Tables>
##PROPERTIES
        <Properties>
                <Property Index="0" Name="Name" Value="%Name.XML%"/>
                <Property Index="1" Name="Author" Value="%Author.XML%"/>
                <Property Index="2" Name="Version" Value="%Version.XML%"/>
                <Property Index="3" Name="About" Value="%About.XML%"/>
                <Property Index="4" Name="Character Set" Value="%Character-Set%"/>
                <Property Index="5" Name="Character Mapping" Value="%Character-Mapping%"/>
                <Property Index="6" Name="Generated By" Value="%Generated-By%"/>
                <Property Index="7" Name="Generated Date" Value="%Generated-Date%"/>
        </Properties>
##END-PROPERTIES
##SYMBOL-TABLE
        <SymbolTable Count="%Count%">
##SYMBOLS
                <Symbol Index="%Index%" Name="%Name.XML%" Type="%Type%"/>
##END-SYMBOLS
        </SymbolTable>
##END-SYMBOL-TABLE
##GROUP-TABLE
        <GroupTable Count="%Count%">
##TRUE-VALUE True
##FALSE-VALUE False
##GROUPS
                <Group Index="%Index%" Name="%Name.XML%" ContainerIndex="%Container%" StartIndex="%Start%" EndIndex="%End%" Advance="%Advance%" Ending="%Ending%" NestingCount="%Nesting-Count%">
##NESTED-GROUPS
                        <NestedGroup Index="%Index%"/>
##END-NESTED-GROUPS
                </Group>
##END-GROUPS
        </GroupTable>
##END-GROUP-TABLE
##PRODUCTION-TABLE
        <ProductionTable Count="%Count%">
##PRODUCTIONS
                <Production Index="%Index%" NonTerminalIndex="%Nonterminal-Index%" SymbolCount="%Symbol-Count%">
##PRODUCTION-SYMBOLS
                        <ProductionSymbol SymbolIndex="%Symbol-Index%"/>
##END-PRODUCTION-SYMBOLS
                </Production>
##END-PRODUCTIONS
        </ProductionTable>
##END-PRODUCTION-TABLE
##CHAR-SET-TABLE
        <CharSetTable Count="%Count%">
##CHAR-SETS        
                <CharSet Index="%Index%" Count="%Char-Count%">
##CHARS                
                        <Char UnicodeIndex="%Unicode-Index%"/>
##END-CHARS
                </CharSet>
##END-CHAR-SETS
        </CharSetTable>
##END-CHAR-SET-TABLE
##DFA-TABLE
        <DFATable Count="%Count%" InitialState="%Initial-State%">
##DFA-STATES
                <DFAState Index="%Index%" EdgeCount="%Edge-Count%" AcceptSymbol="%Accept-Index%">
##DFA-EDGES
                        <DFAEdge CharSetIndex="%Char-Set-Index%" Target="%Target%"/>
##END-DFA-EDGES
                </DFAState>
##END-DFA-STATES 
        </DFATable>
##END-DFA-TABLE
##LALR-TABLE
        <LALRTable Count="%Count%" InitialState="%Initial-State%">
##LALR-STATES
                <LALRState Index="%Index%" ActionCount="%Action-Count%">
##LALR-ACTIONS
                        <LALRAction SymbolIndex="%Symbol-Index%" Action="%Action%" Value="%Value%"/>
##END-LALR-ACTIONS        
                </LALRState>
##END-LALR-STATES  
        </LALRTable>
##END-LALR-TABLE
</Tables>