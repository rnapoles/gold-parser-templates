##LANGUAGE 'C'
##TEMPLATE-NAME 'Constants Only'
##ENGINE-NAME 'None'
##SYSTEM-VERSION 'N/A'
##AUTHOR 'Devin Cook' 
##FILE-EXTENSION 'c'
##NOTES
This template creates to set of ANSI C constants for the grammar's symbols and rules.
##END-NOTES
##ID-CASE UPPERCASE
##ID-SEPARATOR '_'
##ID-SYMBOL-PREFIX 'SYM'
##ID-RULE-PREFIX 'PROD'
##SYMBOLS
const int %ID.Padded% = %Value.Padded%; /* %Description% */
##END-SYMBOLS

##PRODUCTIONS
const int %ID.Padded% = %Value.Padded%; /* %Description% */
##END-PRODUCTIONS