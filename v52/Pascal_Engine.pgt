  {$UNDEF  Debug_LEXEMES  //define if lexemes are to be dumped, before they are tokenized}
  {$DEFINE Debug_TOKENS   //define if tokenized lexemes are to be dumped} 
  {$UNDEF  Debug_PARSER   //define if parser (LALR) states are to be dumped} 
  {$DEFINE Debug_ACTIONS  //define if called actions are to be dumped } 
  {$DEFINE Debug_ERRORS   //undefine if not used} 
  {$UNDEF  Debug_HEAPMEM  //define if status of memory heap is to be reported} 
//-----------------------------------------------------------------------------

const 
      Tab=chr(9);
      LF=Chr(10); 
      CR=Chr(13);  
      FF=Chr(12);
      EOF=Chr(26);

//-----------------------------------------------------------------------------
// ERROR TAGS
//-----------------------------------------------------------------------------
const Err_Lexeme        = 1;
      Err_Skipped       = 2; 
      Err_Halted        = 3;
      Err_Overflow      = 4;
      Err_StackOverflow = 5;

//-----------------------------------------------------------------------------
// TOKEN TAGS
//-----------------------------------------------------------------------------
##SYMBOL-TABLE
const TagCount = %Count%;
##SYMBOLS
      Tag_%ID.Padded%= %Value.Padded%;   // Kind=%Kind%;  Lex='%Description%';  
##END-SYMBOLS
      TagAny = %Count%;
      //TAG_COMMENTLINE = TagAny + 1;
      //TAG_COMMENTSTART = TagAny + 2;
      //TAG_COMMENTSTART1 = TagAny + 3;
      //TAG_COMMENTSTART2 = TagAny + 4;
      //TAG_COMMENTEND = TagAny + 5;
      //TAG_COMMENTEND1 = TagAny + 6;
      //TAG_COMMENTEND2 = TagAny + 7; 

      //the length evaluation is a bit clumsy, but GoldParser offers no alternative
##SYMBOLS
      Lex_%Value%: string[length('%Description%')] ='%Description%';
##END-SYMBOLS
      Lex_%Count%: string[7] ='<:ANY:>';

      LexTable : array[0..%Count%] of ^String = (
##SYMBOLS
      @Lex_%Value%,
##END-SYMBOLS
      @Lex_%Count%);
##END-SYMBOL-TABLE

type  
  TTokenTag    = 0..TagCount;
  TToken       = record 
    Tag:TTokenTag; 
    LinePos, CharPos: Integer; 
    Kind:0..5; 
  end;

  PToken       = ^TToken;
  TTokenList   = array [1..100] of TToken;
  PTokenList   = ^TTokenList;
  PText        = ^Text;

var
  Fo,Fe:PText;

//-----------------------------------------------------------------------------
// OBJECTS (SCANNER,LEXER,PARSER)
//-----------------------------------------------------------------------------
Type
  TScanner = class
    Fi:Text;
    CurChar:    Char;
    NextChar:   Char;
    procedure   Get; virtual;
    constructor Create(FileName:String);
    destructor  Destroy; virtual;
  end;

  TLexer = class(TScanner)
    ErrorMax:   Integer;
    ErrorCnt:   Integer;
    LinePos:	Integer;
    CharPos:	Integer;
    LexemeLen:  Integer;
    LexemeStr:  String;
