##LANGUAGE 'C++'
##TEMPLATE-NAME 'Constants Only'
##ENGINE-NAME 'None'
##SYSTEM-VERSION 'N/A'
##AUTHOR 'Devin Cook' 
##FILE-EXTENSION 'cpp'
##NOTES
This template creates to set of C++ enumerated constants for the grammar's symbols and rules.
##END-NOTES
##ID-CASE UPPERCASE
##ID-SEPARATOR '_'
##ID-SYMBOL-PREFIX 'Sym'
##ID-RULE-PREFIX 'Prod'
enum SymbolConstants
{
##SYMBOLS
##DELIMITER ','
   %ID.Padded% = %Value.Padded%%Delimiter% // %Description%
##END-SYMBOLS
};

enum ProductionConstants
{
##RULES
##DELIMITER ','
   %ID.Padded% = %Value.Padded%%Delimiter% // %Description%
##END-RULES
};