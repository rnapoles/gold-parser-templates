##LANGUAGE 'Text'
##TEMPLATE-NAME 'INI File'
##ENGINE-NAME 'None'
##SYSTEM-VERSION 'N/A'
##AUTHOR 'Devin Cook' 
##FILE-EXTENSION 'ini'
##NOTES
This template outputs all the tables using the classic (but still useful) .ini format.
##END-NOTES
##DELIMITER ', '
[Properties]
##PROPERTIES
Name              = %Name%
Version           = %Version%
Author            = %Author%
About             = %About%
Character Set     = %Character-Set%
Character Mapping = %Character-Mapping%
Generated By      = %Generated-By%
Generated Date    = %Generated-Date%
##END-PROPERTIES

##SYMBOL-TABLE
[Symbol Table]
Table Count= %Count%

##SYMBOLS
[Symbol]
Index = %Index%
Name  = %Name%
Value = %Value%
Type  = %Type%
Group = %Group%

##END-SYMBOLS
##END-SYMBOL-TABLE

[Group Table]
##GROUP-TABLE
Table Count= %Count%
##GROUPS

[Group]
Index      = %Index%
Name       = %Name%
Container  = %Container%
Start      = %Start%
End        = %End%
Advanced   = %Advance%
Ending     = %Ending%
Nesting    = %Nesting-List%

##END-GROUPS
##END-GROUP-TABLE

##PRODUCTION-TABLE
[Production Table]
Table Count= %Count%

##PRODUCTIONS
[Production]
Index        = %Index%
Value        = %Value%
Nonterminal  = %Nonterminal-Index%
Description  = %Description%
Symbol Count = %Symbol-Count%
Handle       = %Symbol-List%

##END-PRODUCTIONS
##END-PRODUCTION-TABLE

##CHAR-SET-TABLE
[Character Set Table]
Table Count= %Count%
##DELIMITER ','
##RANGE-CHARS '..'

##CHAR-SETS
[Character Set] 
Index   = %Index%
Count   = %Char-Count% 
Chars   = %Chars.Range-List%

##END-CHAR-SETS
##END-CHAR-SET-TABLE

##DFA-TABLE
[DFA Table]
Table Count= %Count%
Initial State= %Initial-State%

##DFA-STATES
[DFA State]
Index = %Index%
Accept= %Accept-Index%
Edge Count= %Edge-Count%
     
##DFA-EDGES     
[DFA Edge]
State Index    = %Index%
Char Set Index = %Char-Set-Index%
Target State   = %Target%

##END-DFA-EDGES
##END-DFA-STATES
##END-DFA-TABLE

##LALR-TABLE
[LALR Table]
Table Count   = %Count%
Initial State = %Initial-State%

##LALR-STATES
[LALR State]
Index        = %Index%   
Action Count = %Action-Count%

##LALR-ACTIONS
[LALR Action]
State Index   = %Index%   
Symbol Index  = %Symbol-Index% 
Action Name   = %Action-Name% 
Action        = %Action%
Target        = %Value%

##END-LALR-ACTIONS
##END-LALR-STATES
##END-LALR-TABLE
