##LANGUAGE 'C'
##TEMPLATE-NAME 'template.c'
##ENGINE-NAME 'Kessels Engine'
##SYSTEM-VERSION '1.0'
##AUTHOR 'J.C. Kessels'
##FILE-EXTENSION 'c'
##NOTES
This template creates the source for a bare-bones interpreter. The
resulting code is executable and will show the progress of the
interpreter as it executes an input script.
##END-NOTES
##ID-SEPARATOR '_'
##ID-SYMBOL-PREFIX 'Symbol'
##ID-RULE-PREFIX 'Rule'
##DELIMITER ','
/*
This file was generated by the "C - Kessels engine template.c" template.
*/


#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <wchar.h>

#include "engine.h"                 /* The Kessels engine. */
##PARAMETERS
#include "%Name%.h"                 /* Generated by GOLD. */
##END-PARAMETERS


#define TRIMREDUCTIONS 1            /* 0=off, 1=on */
int Debug = 1;                      /* 0=off, 1=on */

/* Load input file from disk into memory as wchar_t string. */
wchar_t *LoadInputFile(char *FileName, long *InputSize) {
  FILE *Fin;
  char *InputBuf;
  wchar_t *WInputBuf;
  struct stat statbuf;
  size_t BytesRead;
  size_t WCharsCount;
  long i;

  if (InputSize != NULL)
    *InputSize = 0;

  /* Sanity check. */
  if ((FileName == NULL) || (*FileName == '\0'))
    return (NULL);

  /* Open the file. */
  Fin = fopen(FileName, "rb");
  if (Fin == NULL) {
    fprintf(stdout, "Could not open input file: %s\n", FileName);
    return (NULL);
  }

  /* Get the size of the file. */
  if (fstat(fileno(Fin), &statbuf) != 0) {
    fprintf(stdout, "Could not stat() the input file: %s\n", FileName);
    fclose(Fin);
    return (NULL);
  }

  /* Allocate memory for the input. */
  InputBuf = (char *)malloc(statbuf.st_size + 1);
  if (InputBuf == NULL) {
    fprintf(stdout, "Not enough memory to load the file: %s\n", FileName);
    fclose(Fin);
    return (NULL);
  }

  /* Load the file into memory. */
  BytesRead = fread(InputBuf, 1, statbuf.st_size, Fin);
  InputBuf[statbuf.st_size] = '\0';

  /* Close the file. */
  fclose(Fin);

  /* Exit if there was an error while reading the file. */
  if (BytesRead != (size_t)statbuf.st_size) {
    fprintf(stdout, "Error while reading input file: %s\n", FileName);
    free(InputBuf);
    return (NULL);
  }

  /* Allocate memory for wide character buffer. */
  WInputBuf = (wchar_t *)malloc((statbuf.st_size + 1) * sizeof(wchar_t));
  if (WInputBuf == NULL) {
    fprintf(stdout, "Not enough memory to convert input to wide characters.\n");
    free(InputBuf);
    return (NULL);
  }

  /* Convert to wchar_t */
  WCharsCount = mbstowcs(WInputBuf, InputBuf, statbuf.st_size + 1);
  if (WCharsCount == (size_t)-1) {
    /* Fallback byte-by-byte conversion */
    for (i = 0; i < statbuf.st_size; i++) {
      WInputBuf[i] = (wchar_t)(unsigned char)InputBuf[i];
    }
    WInputBuf[statbuf.st_size] = 0;
    WCharsCount = statbuf.st_size;
  }

  free(InputBuf);
  if (InputSize != NULL)
    *InputSize = (long)WCharsCount;
  return (WInputBuf);
}

/* Make a readable copy of a wide string. All characters outside 32...126 are
   displayed as a HEX number in square brackets, for example "[0A]". */
void ReadableString(wchar_t *Input, char *Output, long int Width) {
  char s1[BUFSIZ];

  if (Output == NULL)
    return;
  while ((Input != NULL) && (*Input != 0)) {
    if ((*Input >= 32) && (*Input <= 126)) {
      if (Width > 1)
        *Output++ = (char)*Input;
    } else {
      if (Width > 6) {
        sprintf(s1, "[%04X]", (unsigned int)*Input);
        char *p = s1;
        while (*p)
          *Output++ = *p++;
      }
    }
    Input++;
  }
  *Output = '\0';
}

void ShowErrorMessage(struct TokenStruct *Token, char *Message) {
  char s1[BUFSIZ];

  if (Token == NULL) {
    fprintf(stdout, "%s.\n", Message);
    return;
  }
  if (Token->Data == NULL) {
    fprintf(stdout, "%s at line %ld column %ld.\n", Message, Token->Line,
            Token->Column);
    return;
  }
  ReadableString(Token->Data, s1, BUFSIZ);
  fprintf(stdout, "%s at line %ld column %ld: %s\n", Message, Token->Line,
          Token->Column, s1);
}

void ShowIndent(int Indent) {
  int i;
  for (i = 0; i < Indent; i++)
    fprintf(stdout, "  ");
}

/* Forward declaration of Interpret(); */
char *Interpret(struct TokenStruct *Token, int Debug, int Indent);

##RULE-TABLE
##RULES
/* %Description% */
char *%ID%(struct TokenStruct *Token, int Debug, int Indent) {

  /* Arguments: %SymbolCount% */
  int i;
  char *Value;

  /* This is just an example of how to fetch the arguments. Usually
   you won't need them all. Remember to free() all the results! */
  for (i = 0; i < Grammar.RuleArray[Token->ReductionRule].SymbolsCount; i++) {
    Value = Interpret(Token->Tokens[i],Debug,Indent);
    if (Value != NULL) free(Value);
  }

  /* Return a result. In this example it's always NULL, but it could
   be a real result needed by the rule that is calling. */
  return(NULL);
};



##END-RULES
##END-RULE-TABLE
##RULE-TABLE
char *(*RuleJumpTable[])(struct TokenStruct *Token, int Debug, int Indent) = {
##RULES

  /* %Index%. %Description% */
  %ID%%Delimiter%
##END-RULES
};
##END-RULE-TABLE

/* Walk through the parsed input script and interpret (execute, evaluate)
   all the statements. This is the heart of the beast and it's executed a
   great many times. You will want to keep it as light as possible.
   Input is a Token, output is a string. The Token can be:
   - A symbol: return the Data of the Token.
   - A reduction (a Rule with all it's arguments): call the Rule's
     function and return it's result.
   */
char *Interpret(struct TokenStruct *Token, int Debug, int Indent) {
  char s1[BUFSIZ];

  /* Sanity check. */
  if (Token == NULL)
    return (NULL);

  /* If it's a symbol (terminal) then return the value. */
  if (Token->ReductionRule < 0) {
    if (Debug > 0) {
      ShowIndent(Indent);
      if (Token->Data != NULL) {
        ReadableString(Token->Data, s1, BUFSIZ);
        fprintf(stdout, "%s\n", s1);
      }
    }
    if (Token->Data == NULL)
      return (NULL);
    ReadableString(Token->Data, s1, BUFSIZ);
    return (strdup(s1));
  }

  /* Sanity check. */
  if (Token->Tokens == NULL)
    return (NULL);

  /* Call the rule and return the result. */
  if (Debug > 0) {
    ShowIndent(Indent);
    fprintf(stdout, "%S\n",
            Grammar.RuleArray[Token->ReductionRule].Description);
  }
  return (RuleJumpTable[Token->ReductionRule](Token, Debug, Indent + 1));
}

int main(int argc, char *argv[]) {
  wchar_t *InputBuf;
  long InputSize = 0;
  struct TokenStruct *Token = NULL;
  int Result;
  char *FileName = "Example.input";

  if (argc > 1) {
    FileName = argv[1];
  }

  /* Load the inputfile into memory. */
  InputBuf = LoadInputFile(FileName, &InputSize);
  if (InputBuf == NULL)
    exit(1);

  /* Run the Parser. */
  Result = Parse(InputBuf, InputSize, TRIMREDUCTIONS, 0, &Token);

  /* Show a message about the Parser result. */
  switch (Result) {
  case PARSEMEMORYERROR:
    fprintf(stdout, "Error: not enough memory to parse the input.\n");
    break;
  case PARSELEXICALERROR:
    ShowErrorMessage(Token, "Lexical error");
    break;
  case PARSECOMMENTERROR:
    ShowErrorMessage(Token, "Comment error");
    break;
  case PARSETOKENERROR:
    ShowErrorMessage(Token, "Tokenizer error");
    break;
  case PARSESYNTAXERROR:
    ShowErrorMessage(Token, "Syntax error");
    break;
  case PARSEACCEPT:
    if (Debug > 0)
      fprintf(stdout, "\nStarting to interpret:\n");
    Interpret(Token, Debug, -1);
    break;
  }

  /* Cleanup. */
  DeleteTokens(Token);
  free(InputBuf);
  return (Result == PARSEACCEPT ? 0 : 1);
}