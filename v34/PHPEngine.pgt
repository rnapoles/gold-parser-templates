  int *Symbols;
  wchar_t *Description;
};
*/
$GrammarRuleArray = array(
##RULES
  /* %Value.Padded% */   new RuleStruct(%NonterminalIndex%,%SymbolCount%,$GrammarRuleSymbolArray%Index%,"%Description%")%Delimiter%
##END-RULES
  );
##END-RULE-TABLE



##LALR-TABLE
/*
