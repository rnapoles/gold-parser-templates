##PARAMETERS
/* CaseSensitive */      
$Grammar->CaseSensitive = %CaseSensitive%;
/* InitialSymbol */
$Grammar->InitialSymbol = %StartSymbol%;
##END-PARAMETERS
##DFA-TABLE
/* InitialDfaState */
