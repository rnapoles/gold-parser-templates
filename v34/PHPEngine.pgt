  /* %Index% */    new DfaStateStruct(%AcceptIndex%,%EdgeCount%,$GrammarDfaEdgeArray%Index%),
##END-DFA-STATES
  new DfaStateStruct(-1,-1,NULL));
##END-DFA-TABLE



##RULE-TABLE
